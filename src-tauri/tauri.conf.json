{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baron",
  "version": "0.1.0",
  "identifier": "com.baron.companion",
  "build": {
    "beforeDevCommand": "bun --cwd ../frontend run dev",
    "beforeBuildCommand": "bun --cwd ../frontend run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baron",
        "width": 1340,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
